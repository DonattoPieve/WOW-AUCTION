# Copie para .env e preencha. O .env fica fora do Git (veja .gitignore).
#
# As credenciais saem de https://develop.battle.net/access/clients — criar um
# cliente é gratuito e leva um minuto. Sem elas o projeto continua rodando:
# `make seed` popula o banco com um ano de dados fictícios.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Onde o SQLite fica. O padrão é ./wow.db na raiz do projeto.
WOW_DB_PATH=wow.db

# Fatia da quantidade mais barata que entra no valor de mercado (ver ADR 0003).
# 0.15 = os 15% mais baratos do estoque.
WOW_MARKET_VALUE_CUT=0.15
